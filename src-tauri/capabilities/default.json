{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the app's window may do",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "$APPDATA/**" }] },
    "opener:allow-reveal-item-in-dir",
    "dialog:allow-open",
    "allow-load-plan",
    "allow-save-plan",
    "allow-write-excel",
    "allow-data-folder"
  ]
}
