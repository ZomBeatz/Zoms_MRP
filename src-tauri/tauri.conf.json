{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zom's MRP",
  "mainBinaryName": "zoms-mrp",
  "version": "0.2.5",
  "identifier": "com.zombeatz.zoms-mrp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zom's MRP",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "rpm", "appimage", "dmg"],
    "category": "Productivity",
    "shortDescription": "Schedule helicopter missions, crews and maintenance",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "publisher": "ZomBeatz Media",
    "copyright": "© ZomBeatz Media",
    "license": "MIT",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/ZomBeatz/Zoms_MRP/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
